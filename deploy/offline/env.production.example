# Enterprise Agent Platform production offline environment

MATERIAL_AGENT_PROJECTS_ROOT=/opt/enterprise-agent-platform/data/projects
MATERIAL_AGENT_ALLOWED_INPUT_ROOTS=/opt/enterprise-agent-platform/data/projects:/opt/enterprise-agent-platform/data/uploads

MATERIAL_AGENT_OUTPUT_DIR=/opt/enterprise-agent-platform/data/outputs
MATERIAL_AGENT_TASK_STORE_DIR=/opt/enterprise-agent-platform/data/tasks
AGENT_PLATFORM_KNOWLEDGE_STORE_DIR=/opt/enterprise-agent-platform/data/knowledge_bases

MATERIAL_AGENT_MAX_PREVIEW_ROWS=30
MATERIAL_AGENT_RETRIEVAL_TOP_K=5
MATERIAL_AGENT_CONFIDENCE_THRESHOLD=0.72
MATERIAL_AGENT_AUDIT_ENABLED=true
MATERIAL_AGENT_MODEL_PROVIDER=offline
MATERIAL_AGENT_MODEL_NAME=rule-first
MATERIAL_AGENT_RUN_SYNC_API=false
