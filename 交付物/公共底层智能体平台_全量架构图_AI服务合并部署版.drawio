/权限/配置/任务下发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=1.4;fontColor=#0F172A;fontSize=17;fontStyle=1;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="330" y="505" width="430" height="130" as="geometry"/></mxCell><mxCell id="c11" value="agent-api&lt;br&gt;Python · FastAPI/Uvicorn :8000&lt;br&gt;LangGraph任务编排 · RAG · Tool/MCP&lt;br&gt;Model Gateway模块（进程内，模型路由/限流）&lt;br&gt;REST · SSE · Redis队列" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.4;fontColor=#0F172A;fontSize=16;fontStyle=1;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="890" y="485" width="600" height="160" as="geometry"/></mxCell><mxCell id="c12" value="admin → api（HTTP REST 触发任务） → api进程内：LangGraph编排 → Model Gateway 调内部/远程模型 API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;strokeWidth=1.4;fontColor=#0F172A;fontSize=15;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="430" y="665" width="1040" height="38" as="geometry"/></mxCell><mxCell id="c13" value="Nginx：admin=HTTPS+REST · api=HTTPS+REST/SSE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;strokeWidth=1.4;fontColor=#0F172A;fontSize=15;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="520" y="705" width="860" height="34" as="geometry"/></mxCell><mxCell id="c14" value="③ 持久化" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1.4;fontColor=#0F172A;fontSize=15;fontStyle=1;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="855" y="733" width="190" height="28" as="geometry"/></mxCell><mxCell id="dep15" value="" style="shape=singleArrow;direction=south;html=1;fillColor=#263238;strokeColor=#263238;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="940" y="761" width="20" height="51" as="geometry"/></mxCell><mxCell id="db16" value="数据存储&lt;br&gt;PostgreSQL + pgvector :5432&lt;br&gt;Redis :6379" style="shape=cylinder3d;wh