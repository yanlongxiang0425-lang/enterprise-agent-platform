uot; style=&quot;font-size: 14px&quot;&gt;物料补全主链路是结构化精确查询；RAG 用于指标知识、分类规则解释、字段语义辅助和低置信度场景&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1720" height="70" as="geometry"/></mxCell><mxCell id="lane3" value="知识写入链路" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#C084FC;strokeWidth=1.2;fontStyle=1;fontSize=18;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;arcSize=6;" vertex="1" parent="1"><mxGeometry x="70" y="130" width="760" height="760" as="geometry"/></mxCell><mxCell id="c4" value="文件接入&lt;br&gt;Excel / Word / PDF / 历史指标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.4;fontColor=#0F172A;fontSize=14;fontStyle=1;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="150" y="205" width="590" height="54" as="geometry"/></mxCell><mxCell id="c5" value="Parser Router&lt;br&gt;按文件类型解析为 DocumentModel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.4;fontColor=#0F172A;fontSize=14;fontStyle=1;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="150" y="300" width="590" height="54" as="geometry"/></mxCell><mxCell id="c6" value="结构化抽取&lt;br&gt;表格行、标题层级、字段字典、元数据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.4;fontColor=#0F172A;fontSize=14;fontStyle=1;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="150" y="395" width="590" height="54" as="geometry"/></mxCell><mxCell id="c7" value="Chunk 分块&lt;br&gt;标题层级/表格行/语义段落/Token窗口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.4;fontColor=#0F172A;fontSize=14;fontStyle=1;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="150" y="490" width="590" height="54" as="geometry"/></mxCell><mxCell id="c8" value="Embedding&lt;br&gt;bge-m3 批量向量化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.4;fontColor=#0F172A;fontSize=14;fontStyle=1;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="150" y="585" width="590" height="54" as="geometry"/></mxCell><mxCell id="c9" value="索引落库&lt;br&gt;rag_documents / rag_chunks / pgvector" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.4;fontColor=#0F172A;fontSize=14;fontStyle=1;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="150" y="680" width="590" height="54" as="geometry"/></mxCell><mxCell id="lane10" value="知识检索链路" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#86EFAC;strokeWidth=1.2;fontStyle=1;fontSize=18;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;arcSize=6;" vertex="1" parent="1"><mxGeometry x="970" y="130" width="760" height="760" as="geometry"/></mxCell><mxCell id="c11" value="Query 理解&lt;br&gt;抽取问题、业务域、过滤条件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.4;fontColor=#0F172A;fontSize=14;fontStyle=1;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1050" y="205" width="590" height="54" as="geometry"/></mxCell><mxCell id="c12" value="检索路由&lt;br&gt;结构化过滤 / 向量召回 / 混合检索" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.4;fontColor=#0F172A;fontSize=14;fontStyle=1;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1050" y="300" width="590" height="54" as="geometry"/></mxCell><mxCell id="c13" value="候选召回&lt;br&gt;pgvector topK + metadata filter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.4;fontColor=#0F172A;fontSize=14;fontStyle=1;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1050" y="395" width="590" height="54" as="geometry"/></mxCell><mxCell id="c14" value="重排过滤&lt;br&gt;reranker + 权限/来源/版本过滤" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColo