ounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1.4;fontColor=#0F172A;fontSize=14;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="390" y="890" width="10" height="10" as="geometry"/></mxCell><mxCell id="e49" value="11. 返回进度/结果地址" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="c47" target="c48"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c50" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1.4;fontColor=#0F172A;fontSize=14;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="390" y="955" width="10" height="10" as="geometry"/></mxCell><mxCell id="c51" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1.4;fontColor=#0F172A;fontSize=14;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="160" y="955" width="10" height="10" as="geometry"/></mxCell><mxCell id="e52" value="12. 下载 JSON 或 Excel 报告" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="c50" target="c51"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="RAG写入与检索流程图"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title2" value="&lt;b&gt;&lt;font style=&quot;font-size: 26px&quot;&gt;RAG 知识库写入、Chunk 分块与检索流程&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size: 14px&quot;&gt;物料补全主链路是结构化精确查询；RAG 用于指标知识、分类规则解释、字段语义辅助和低置信度场景&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middl