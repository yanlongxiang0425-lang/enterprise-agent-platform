<mxfile host="app.diagrams.net"><diagram name="记忆设计"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title2" value="&lt;b&gt;&lt;font style=&quot;font-size: 26px&quot;&gt;短期记忆与长期记忆设计图&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size: 14px&quot;&gt;短期记忆承载一次 Run 的过程状态；长期记忆沉淀领域知识、字段映射、人工确认和评测样本&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1720" height="70" as="geometry"/></mxCell><mxCell id="lane3" value="短期记忆：Run / Session Scope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=1.2;fontStyle=1;fontSize=18;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;arcSize=6;" vertex="1" parent="1"><mxGeometry x="80" y="140" width="740" height="520" as="geometry"/></mxCell><mxCell id="c4" value="Conversation Buffer&lt;br&gt;当前任务输入/用户反馈" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.4;fontColor=#0F172A;fontSize=14;fontStyle=1;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="150" y="230" width="250" height="70" as="geometry"/></mxCell><mxCell id="c5" value="LangGraph Checkpoint&lt;br&gt;节点状态/工具结果/错误" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.4;fontColor=#0F172A;fontSize=14;fontStyle=1;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="470" y="230" width="270" height="70" as="geometry"/></mxCell><mxCell id="c6" value="Retrieval Context&lt;br&gt;本轮召回chunk/schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=1.4;fontColor=#0F172A;fontSize=14;fontStyle=1;spacing=8;arcSize=8;" vertex="1" parent