<mxfile host="app.diagrams.net"><diagram name="数据与部署架构"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title2" value="&lt;b&gt;&lt;font style=&quot;font-size: 26px&quot;&gt;离线单机部署架构图&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size: 14px&quot;&gt;AI能力合并为一个 agent-api 服务；单机 VM 内仅保留 agent-admin 与 agent-api 两个应用单体&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1820" height="70" as="geometry"/></mxCell><mxCell id="c3" value="管理后台 · 业务系统" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.4;fontColor=#0F172A;fontSize=20;fontStyle=1;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="660" y="105" width="580" height="78" as="geometry"/></mxCell><mxCell id="c4" value="① HTTPS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1.4;fontColor=#0F172A;fontSize=15;fontStyle=1;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="855" y="191" width="190" height="28" as="geometry"/></mxCell><mxCell id="dep5" value="" style="shape=singleArrow;direction=south;html=1;fillColor=#263238;strokeColor=#263238;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="940" y="219" width="20" height="48" as="geometry"/></mxCell><mxCell id="c6" value="接入网关&lt;br&gt;Nginx / APISIX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.4;fontColor=#0F172A;fontSize=20;fontStyle=1;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="660" y="255" width="580" height="86" as="geometry"/></mxCell><mxCell id="c7" value="② 路由转发" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1.4;fontColor=#0F172A;fontSize=15;fontStyle=1;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="855" y="349" width="190" height="28" as="geometry"/></mxCell><mxCell id="dep8" value="" style="shape=singleArrow;direction=south;html=1;fillColor=#263238;strokeColor=#263238;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="940" y="377" width="20" height="50" as="geometry"/></mxCell><mxCell id="c9" value="单机 VM · 应用服务（2个单体）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;strokeWidth=1.4;fontColor=#0F172A;fontSize=20;fontStyle=1;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="230" y="415" width="1440" height="310" as="geometry"/></mxCell><mxCell id="c10" value="agent-admin（已有服务）&lt;br&gt;Java · Spring Boot&lt;br&gt;:8080&lt;br&gt;用户/权限/配置/任务下发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=1.4;fontColor=#0F172A;fontSize=17;fontStyle=1;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="330" y="505" width="430" height="130" as="geometry"/></mxCell><mxCell id="c11" value="agent-api&lt;br&gt;Python · FastAPI/Uvicorn :8000&lt;br&gt;LangGraph任务编排 · RAG · Tool/MCP&lt;br&gt;Model Gateway模块（进程内，模型路由/限流）&lt;br&gt;REST · SSE · Redis队列" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.4;fontColor=#0F172A;fontSize=16;fontStyle=1;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="890" y="485" width="600" height="160" as="geometry"/></mxCell><mxCell id="c12" value="admin → api（HTTP REST 触发任务） → api进程内：LangGraph编排 → Model Gateway 调内部/远程模型 API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;strokeWidth=1.4;fontColor=#0F172A;fontSize=15;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="430" y="665" width="1040" height="38" as="geometry"/></mxCell><mxCell id="c13" value="Nginx：admin=HTTPS+REST · api=HTTPS+REST/SSE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=