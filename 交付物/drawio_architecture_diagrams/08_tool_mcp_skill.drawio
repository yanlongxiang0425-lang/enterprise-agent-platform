<mxfile host="app.diagrams.net"><diagram name="Tool MCP Skill调用架构"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title2" value="&lt;b&gt;&lt;font style=&quot;font-size: 26px&quot;&gt;Tool / MCP / Skill 能力体系调用图&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size: 14px&quot;&gt;Tool 解决确定性动作，MCP 解决外部系统协议接入，Skill 封装专家流程与可复用图/文档能力&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1720" height="70" as="geometry"/></mxCell><mxCell id="lane3" value="Agent Node 调用入口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#86EFAC;strokeWidth=1.2;fontStyle=1;fontSize=18;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;arcSize=6;" vertex="1" parent="1"><mxGeometry x="70" y="130" width="1660" height="130" as="geometry"/></mxCell><mxCell id="c4" value="LangGraph Node&lt;br&gt;声明需要的 capability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.4;fontColor=#0F172A;fontSize=14;fontStyle=1;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="180" y="180" width="260" height="55" as="geometry"/></mxCell><mxCell id="c5" value="Capability Registry&lt;br&gt;权限/Schema/超时/重试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.4;fontColor=#0F172A;fontSize=14;fontStyle=1;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="560" y="180" width="260" height="55" as="geometry"/></mxCell><mxCell id="c6" value="Executor Sandbox&lt;br&gt;审计/脱敏/结果校验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE4E6;strokeColor=#E11D48;strokeWidth=1.4;fontColor=#0F172A;fontSize=14;fontStyle=1;spacing=8;arcSize