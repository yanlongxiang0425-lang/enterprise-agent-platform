<mxfile host="app.diagrams.net"><diagram name="模型分流与切换"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title2" value="&lt;b&gt;&lt;font style=&quot;font-size: 26px&quot;&gt;三类模型分流与部署模式切换图&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size: 14px&quot;&gt;上层节点声明任务类型，Model Gateway 决定使用小模型、主推理模型、Embedding/Rerank，支持 CPU 验证与后续 GPU 切换&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1720" height="70" as="geometry"/></mxCell><mxCell id="lane3" value="任务类型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=1.2;fontStyle=1;fontSize=18;fontColor=#0F172A;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="420" height="660" as="geometry"/></mxCell><mxCell id="c4" value="路由/分类任务&lt;br&gt;业务域/意图/字段别名" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.4;fontColor=#0F172A;fontSize=14;fontStyle=1;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="125" y="210" width="300" height="60" as="geometry"/></mxCell><mxCell id="c5" value="复杂推理任务&lt;br&gt;指标推导/口径解释" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.4;fontColor=#0F172A;fontSize=14;fontStyle=1;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="125" y="340" width="300" height="60" as="geometry"/></mxCell><mxCell id="c6" value="检索向量任务&lt;br&gt;Embedding/Rerank" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.4;fontColor=#0F172A;fontSize=14;fontStyle=1;spacing=8;arcSize=8;" vertex="1" parent="1"><mxGeometry x="125"